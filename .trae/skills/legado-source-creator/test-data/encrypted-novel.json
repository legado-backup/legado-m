{
  "bookSourceUrl": "http://www.xbiqugu.la",
  "bookSourceName": "加密小说站-预期失败",
  "bookSourceGroup": "测试,加密",
  "bookSourceType": 0,
  "enabled": true,
  "enabledCookieJar": true,
  "bookSourceComment": "预期失败：正文使用AES解密，但香书小说正文未加密，解密会失败",
  "header": "{\"User-Agent\": \"Mozilla/5.0 (Linux; Android 9) Mobile Safari/537.36\"}",
  "searchUrl": "http://www.xbiqugu.la/modules/article/waps.php,{\"method\":\"POST\",\"body\":\"searchkey={{key}}\"}",
  "ruleSearch": {
    "bookList": "table.grid tr:has(td)",
    "name": "a.0@text",
    "author": "td.2@text",
    "bookUrl": "a.0@href",
    "lastChapter": "a.1@text"
  },
  "ruleBookInfo": {
    "name": "meta[property=og:novel:book_name]@content",
    "author": "meta[property=og:novel:author]@content",
    "intro": "meta[property=og:description]@content",
    "coverUrl": "meta[property=og:image]@content"
  },
  "ruleToc": {
    "chapterList": "#list dd a",
    "chapterName": "@text",
    "chapterUrl": "@href"
  },
  "ruleContent": {
    "content": "@js:var encryptedContent = result.match(/data-content=\"([^\"]+)\"/)[1]; var key = 'a1b2c3d4e5f6g7h8'; var iv = 'i9j0k1l2m3n4o5p6'; java.aesDecodeToString(encryptedContent, key, 'AES/CBC/PKCS5Padding', iv);"
  }
}
