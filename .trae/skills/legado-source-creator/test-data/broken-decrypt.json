{
  "bookSourceUrl": "https://www.broken-decrypt.com",
  "bookSourceName": "解密失败站",
  "bookSourceGroup": "测试,负面测试,加密",
  "bookSourceType": 0,
  "enabled": true,
  "enabledCookieJar": true,
  "searchUrl": "https://www.broken-decrypt.com/search?q={{key}}",
  "ruleSearch": {
    "bookList": "div.search-result",
    "name": "h3.title@text",
    "author": "span.author@text",
    "bookUrl": "a.book-link@href"
  },
  "ruleBookInfo": {
    "name": "h1.book-title@text",
    "tocUrl": "a.toc-link@href"
  },
  "ruleToc": {
    "chapterList": "div.chapter-list li",
    "chapterName": "a@text",
    "chapterUrl": "a@href"
  },
  "ruleContent": {
    "content": "@js:var encryptedContent = result.match(/data-content=\"([^\"]+)\"/)[1]; var key = 'wrongkey12345678'; var iv = 'wrongiv123456789'; java.aesDecodeToString(encryptedContent, key, 'AES/CBC/PKCS5Padding', iv);"
  },
  "_decrypt_test_params": {
    "algo": "AES/CBC/PKCS5Padding",
    "key": "wrongkey12345678",
    "iv": "wrongiv123456789",
    "data": "aGVsbG8=",
    "expected": "解密失败：数据长度非AES块大小倍数(5字节非16倍数)"
  }
}
