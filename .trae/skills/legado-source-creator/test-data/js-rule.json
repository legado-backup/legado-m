{
  "bookSourceName": "JS规则测试源",
  "bookSourceUrl": "http://www.xbiqugu.la",
  "bookSourceGroup": "测试,规则类型",
  "bookSourceType": 0,
  "enabled": true,
  "header": "{\"User-Agent\": \"Mozilla/5.0 (Linux; Android 9) Mobile Safari/537.36\"}",
  "searchUrl": "http://www.xbiqugu.la/modules/article/waps.php,{\"method\":\"POST\",\"body\":\"searchkey={{key}}\"}",
  "ruleSearch": {
    "bookList": "@js:java.getElements('table.grid tr:has(td)')",
    "name": "@js:element.select('td:eq(0) a').text()",
    "author": "@js:element.select('td:eq(2)').text()",
    "bookUrl": "@js:element.select('td:eq(0) a').attr('href')",
    "lastChapter": "@js:element.select('td:eq(1) a').text()"
  },
  "ruleBookInfo": {
    "name": "@js:java.select(src,'meta[property=og:novel:book_name]').attr('content')",
    "author": "@js:java.select(src,'meta[property=og:novel:author]').attr('content')",
    "intro": "@js:java.select(src,'meta[property=og:description]').attr('content')",
    "coverUrl": "@js:java.select(src,'meta[property=og:image]').attr('content')"
  },
  "ruleToc": {
    "chapterList": "@js:java.getElements('#list dd a')",
    "chapterName": "@js:element.text()",
    "chapterUrl": "@js:element.attr('href')"
  },
  "ruleContent": {
    "content": "@js:java.select(src,'#content').html()"
  }
}
