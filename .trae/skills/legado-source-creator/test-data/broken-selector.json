{
  "bookSourceUrl": "https://www.broken-selector.com",
  "bookSourceName": "选择器错误站",
  "bookSourceGroup": "测试,负面测试",
  "bookSourceType": 0,
  "enabled": true,
  "enabledCookieJar": true,
  "searchUrl": "https://www.broken-selector.com/search?q={{key}}",
  "ruleSearch": {
    "bookList": "div.book-item-typo",
    "name": "h3.title@text",
    "author": "span.author@text",
    "bookUrl": "a.book-link@href",
    "coverUrl": "img.cover@src",
    "kind": "span.kind@text",
    "intro": "p.intro@text",
    "lastChapter": "span.last-chapter@text"
  },
  "ruleBookInfo": {
    "name": "h1.book-title@text",
    "author": "span.author-name@text",
    "intro": "div.intro@text",
    "coverUrl": "img.book-cover@src",
    "kind": "span.book-kind@text",
    "tocUrl": "a.toc-link@href"
  },
  "ruleToc": {
    "chapterList": "div.chapter-list li",
    "chapterName": "a@text",
    "chapterUrl": "a@href"
  },
  "ruleContent": {
    "content": "div.content@text"
  }
}
