{
  "cms_type": "maccms-x10",
  "version": "1.0",
  "verified_date": "2026-06-14",
  "verified_source": "GitHub magentron/maccms10-php8 默认模板",
  "description": "苹果CMS X10（maccms10-php8）选择器映射，基于 GitHub magentron/maccms10-php8 升级版默认模板。module- 前缀为 X10 新版模板，与 V10 的 stui- 前缀模板有显著差异。",
  "diff_from_v10": {
    "summary": "X10 是 V10 的 PHP8 升级版，模板全面重构，CSS 类名从 stui- 改为 module- 前缀",
    "key_changes": [
      ".stui-vodlist li → .module-items .module-item",
      ".stui-page a.next → .module-page a.next",
      ".stui-content__playlist a → .module-play-list a",
      ".pic-text → .module-item-note",
      "data-original → data-src（懒加载属性变更）",
      "/index.php/vod/type/id/ → /vodtype/（URL 路径简化）",
      "/vod/detail/id/ → /voddetail/（详情页URL简化）",
      "/vod/play/id/ → /vodplay/（播放页URL简化）"
    ]
  },
  "pages": {
    "list": {
      "description": "视频列表页（首页/分类页）",
      "selectors": {
        "articleList": {
          "primary": ".module-items .module-item",
          "fallbacks": [".stui-vodlist li", ".vodlist li"],
          "note": "视频列表项容器。X10 使用 module-items/module-item 替代 V10 的 stui-vodlist li"
        },
        "title": {
          "primary": "tag.a.0@title",
          "fallbacks": ["tag.a.0@text", ".module-item-title@text"],
          "note": "视频标题。优先取 a 标签的 title 属性，fallback 到文本内容"
        },
        "link": {
          "primary": "tag.a.0@href",
          "fallbacks": ["tag.a@href"],
          "note": "详情页链接。X10 格式为 /voddetail/{id}.html"
        },
        "image": {
          "primary": "tag.img.0@data-src",
          "fallbacks": ["tag.img.0@data-original", "tag.img.0@src"],
          "note": "封面图片。X10 使用 data-src 替代 V10 的 data-original 作为懒加载属性"
        },
        "description": {
          "primary": ".module-item-note@text",
          "fallbacks": [".pic-text@text"],
          "note": "备注/集数信息。X10 使用 module-item-note 替代 V10 的 pic-text，显示 HD/4K/更新至N集等"
        },
        "nextPage": {
          "primary": ".module-page a.next@href",
          "fallbacks": [".stui-page a.next@href", ".page-next a@href"],
          "note": "下一页链接。X10 使用 module-page 替代 V10 的 stui-page"
        }
      }
    },
    "detail": {
      "description": "视频详情页",
      "selectors": {
        "title": {
          "primary": ".module-info-heading-title@text",
          "fallbacks": ["h1.title@text", "h1@text"],
          "note": "视频标题。X10 使用 module-info-heading-title 替代 V10 的 js-vod-name"
        },
        "cover": {
          "primary": ".module-info-cover img@data-src",
          "fallbacks": [".module-info-cover img@data-original", ".module-info-cover img@src"],
          "note": "封面图片。X10 使用 data-src 懒加载属性"
        },
        "playList": {
          "primary": ".module-play-list a",
          "fallbacks": [".stui-content__playlist a", ".playlist a"],
          "note": "播放列表链接。X10 使用 module-play-list 替代 V10 的 stui-content__playlist"
        },
        "playSourceTab": {
          "primary": ".module-tab-item",
          "fallbacks": [".play_source_tab a", "#NumTab a"],
          "note": "播放源标签页切换按钮，data-dropdown-value 属性标识源序号"
        },
        "blurb": {
          "primary": ".module-info-introduction-content@text",
          "fallbacks": [".js-vod-blurb@text", ".desc@text"],
          "note": "简介/摘要"
        },
        "actor": {
          "primary": ".module-info-item:contains(主演) .module-info-item-content@text",
          "fallbacks": [".js-vod-actor-line@text"],
          "note": "主演信息"
        },
        "director": {
          "primary": ".module-info-item:contains(导演) .module-info-item-content@text",
          "fallbacks": [".js-vod-director-line@text"],
          "note": "导演信息"
        }
      }
    },
    "search": {
      "description": "搜索页",
      "selectors": {
        "articleList": {
          "primary": ".module-items .module-item",
          "fallbacks": [".stui-vodlist li", ".vodlist li"],
          "note": "搜索结果列表项。与 list 页结构一致"
        },
        "title": {
          "primary": "tag.a.0@title",
          "fallbacks": ["tag.a.0@text", ".module-item-title@text"],
          "note": "视频标题"
        },
        "link": {
          "primary": "tag.a.0@href",
          "fallbacks": ["tag.a@href"],
          "note": "详情页链接"
        },
        "image": {
          "primary": "tag.img.0@data-src",
          "fallbacks": ["tag.img.0@data-original", "tag.img.0@src"],
          "note": "封面图片"
        },
        "nextPage": {
          "primary": ".module-page a.next@href",
          "fallbacks": [".stui-page a.next@href", ".page-next@href"],
          "note": "下一页链接"
        },
        "searchUrl": {
          "templates": [
            "/vodsearch/{wd}.html",
            "/vodsearch/{wd}-{page}.html"
          ],
          "note": "搜索URL模板。X10 使用简化路径 /vodsearch/ 替代 V10 的 /index.php/vod/search/wd/"
        }
      }
    },
    "play": {
      "description": "播放页",
      "selectors": {
        "playerVar": {
          "primary": "player_aaaa",
          "fallbacks": ["player_data", "player_info"],
          "note": "苹果CMS播放页JS变量名。X10 与 V10 一致，标准为 player_aaaa"
        },
        "playerUrl": {
          "primary": "js:JSON.parse(player_aaaa).url",
          "fallbacks": ["js:player_aaaa.url", "js:JSON.parse(player_data).url"],
          "note": "播放地址提取规则。player_aaaa 为 JSON 字符串，需解析后取 url 字段"
        },
        "playerName": {
          "primary": "js:JSON.parse(player_aaaa).name",
          "fallbacks": ["js:player_aaaa.name"],
          "note": "当前集数名称"
        },
        "playList": {
          "primary": ".module-play-list a",
          "fallbacks": [".stui-content__playlist a", ".playlist a"],
          "note": "播放列表链接（播放页通常也包含完整播放列表）"
        },
        "prevEpisode": {
          "primary": ".module-player-nav-item:first@href",
          "fallbacks": ["a:contains(上一集)@href"],
          "note": "上一集链接"
        },
        "nextEpisode": {
          "primary": ".module-player-nav-item:last@href",
          "fallbacks": ["a:contains(下一集)@href"],
          "note": "下一集链接"
        }
      }
    },
    "sortUrl": {
      "description": "分类URL模板",
      "templates": {
        "电影": "/vodtype/1.html",
        "连续剧": "/vodtype/2.html",
        "动漫": "/vodtype/3.html",
        "综艺": "/vodtype/4.html"
      },
      "filterTemplates": {
        "按类型": "/vodtype/{typeId}-class-{class}.html",
        "按地区": "/vodtype/{typeId}-area-{area}.html",
        "按年份": "/vodtype/{typeId}-year-{year}.html",
        "按排序": "/vodtype/{typeId}-by-{by}.html",
        "分页": "/vodtype/{typeId}-{page}.html"
      },
      "note": "X10 使用简化路径 /vodtype/ 替代 V10 的 /index.php/vod/type/id/。筛选参数使用连字符拼接而非路径层级"
    }
  },
  "commonPatterns": {
    "lazyLoad": {
      "attribute": "data-src",
      "fallbacks": ["data-original", "data-lazy-src"],
      "note": "X10 使用 data-src 替代 V10 的 data-original 作为懒加载属性"
    },
    "urlFormat": {
      "detail": "/voddetail/{id}.html",
      "play": "/vodplay/{id}-{sid}-{nid}.html",
      "search": "/vodsearch/{wd}.html",
      "type": "/vodtype/{typeId}.html",
      "note": "X10 URL 格式全面简化，省略了 V10 的 /index.php/vod/ 前缀和 /id/ 路径段"
    },
    "cssPrefix": {
      "v10": "stui-",
      "x10": "module-",
      "note": "X10 模板 CSS 类名从 stui- 前缀全面改为 module- 前缀，这是区分 V10 和 X10 的最显著特征"
    }
  }
}
