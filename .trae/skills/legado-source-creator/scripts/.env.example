# 数据库配置
LEGADO_DB_HOST=127.0.0.1
LEGADO_DB_PORT=3306
LEGADO_DB_USER=root
LEGADO_DB_PASSWORD=
LEGADO_DB_NAME=legado_sources

# Web 服务配置
LEGADO_WEB_HOST=127.0.0.1
LEGADO_WEB_PORT=8080

# 爬取配置
LEGADO_FETCH_DELAY=1.0
LEGADO_FETCH_TIMEOUT=30

# Legado 真机配置（默认设备，可选）
LEGADO_DEVICE_HOST=
LEGADO_DEVICE_PORT=1122
# WebSocket 端口 = HTTP 端口 + 1（源码硬编码，无需单独配置）
LEGADO_DEVICE_AUTH_TOKEN=
