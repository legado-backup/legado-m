<?xml version="1.0" encoding="utf-8"?>
<!--
  JVM 单测清单（B5·R23 引入 includeAndroidResources 后 AGP 会为单测变体生成并合并测试清单）。
  必须与 src/main/AndroidManifest.xml 保持同一份 overrideLibrary 白名单：
  下列库声明 minSdk 24 而本项目 minSdk 23，主清单已用 tools:overrideLibrary 覆盖；
  单测清单若不同样覆盖，会以
  "uses-sdk:minSdkVersion 23 cannot be smaller than version 24 declared in library" 直接失败。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="com.qmdeve.liquidglass,top.yukonga.miuix.kmp,org.chromium.net.bundled,org.chromium.net,com.google.net.cronet.granular.cronet,com.google.net.cronet.granular.cronet_api,com.google.net.cronet.granular.cronet_embedded,com.google.net.cronet.granular.cronet_common,com.google.net.cronet.granular.cronet_fallback,com.google.net.cronet.granular.cronet_shared,com.google.net.cronet.granular.httpengine_native_provider" />

</manifest>