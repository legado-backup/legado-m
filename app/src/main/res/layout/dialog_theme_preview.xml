<?xml version="1.0" encoding="utf-8"?>
<!-- THEME-E-05 主题预览 Dialog 布局（P1 / ADR-010a） -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/primaryText"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tv_theme_mode"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="主题名称" />

    <TextView
        android:id="@+id/tv_theme_mode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:textColor="@color/secondaryText"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_title"
        tools:text="日间" />

    <ImageView
        android:id="@+id/iv_background"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginTop="14dp"
        android:background="@color/md_grey_200"
        android:contentDescription="@string/theme_preview_bg"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <TextView
        android:id="@+id/tv_color_primary_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/theme_preview_primary"
        android:textColor="@color/secondaryText"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_background" />

    <View
        android:id="@+id/v_color_primary"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:background="@color/md_brown_500"
        app:layout_constraintEnd_toStartOf="@id/v_color_accent"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_color_primary_label" />

    <TextView
        android:id="@+id/tv_color_accent_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/theme_preview_accent"
        android:textColor="@color/secondaryText"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/v_color_accent"
        app:layout_constraintTop_toBottomOf="@id/iv_background" />

    <View
        android:id="@+id/v_color_accent"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:background="@color/md_red_600"
        app:layout_constraintEnd_toStartOf="@id/v_color_background"
        app:layout_constraintStart_toEndOf="@id/v_color_primary"
        app:layout_constraintTop_toBottomOf="@id/tv_color_accent_label" />

    <TextView
        android:id="@+id/tv_color_background_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/theme_preview_background"
        android:textColor="@color/secondaryText"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/v_color_background"
        app:layout_constraintTop_toBottomOf="@id/iv_background" />

    <View
        android:id="@+id/v_color_background"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:background="@color/md_grey_100"
        app:layout_constraintEnd_toStartOf="@id/v_color_bottom"
        app:layout_constraintStart_toEndOf="@id/v_color_accent"
        app:layout_constraintTop_toBottomOf="@id/tv_color_background_label" />

    <TextView
        android:id="@+id/tv_color_bottom_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/theme_preview_bottom"
        android:textColor="@color/secondaryText"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/v_color_bottom"
        app:layout_constraintTop_toBottomOf="@id/iv_background" />

    <View
        android:id="@+id/v_color_bottom"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:background="@color/md_grey_200"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/v_color_background"
        app:layout_constraintTop_toBottomOf="@id/tv_color_bottom_label" />

    <TextView
        android:id="@+id/tv_font_ui"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/secondaryText"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_color_primary"
        tools:text="UI 字体：默认" />

    <TextView
        android:id="@+id/tv_font_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/secondaryText"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_font_ui"
        tools:text="标题字体：默认" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="8dp"
        android:minHeight="42dp"
        android:text="@string/close"
        app:layout_constraintEnd_toStartOf="@id/btn_apply"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_font_title" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_apply"
        style="@style/Widget.Material3.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="18dp"
        android:minHeight="42dp"
        android:text="@string/theme_preview_apply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_close"
        app:layout_constraintTop_toBottomOf="@id/tv_font_title" />

</androidx.constraintlayout.widget.ConstraintLayout>
