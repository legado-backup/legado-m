<?xml version="1.0" encoding="utf-8"?>
<!--
    video-cache-and-multiep R7 / V4：选集网格单元（5 列）。
    选中/未选中样式由 EpisodeGridAdapter 经 applyVideoChoiceItemStyle 运行时按主题设置。

    book-info-unified-cache AD-05：外层改 FrameLayout，右上角叠加「已缓存」勾选角标
    （文本 ✓，颜色由代码从主题强调色取，避免 XML 硬编码色）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="40dp">

    <TextView
        android:id="@+id/text1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textSize="@dimen/text_13sp" />

    <TextView
        android:id="@+id/episode_cached_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:paddingEnd="3dp"
        android:paddingTop="1dp"
        android:text="✓"
        android:textSize="9sp"
        android:visibility="gone" />
</FrameLayout>
